{
  "name": "yespajak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --coverage tests/unit src",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "test:system": "vitest run --passWithNoTests tests/system",
    "test:mutation": "stryker run",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:system",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@jangkar/testing-engines": "github:vinsonsid/jangkar-testing-engines#v0.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^59.10.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/eslint-plugin": "^1.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bash .claude/hooks/pre-commit.sh"
  }
}
